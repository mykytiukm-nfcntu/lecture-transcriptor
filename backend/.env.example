# Application
APP_ENV=local
LOG_LEVEL=INFO

# Storage
DATABASE_URL=sqlite:///./storage/app.db
STORAGE_ROOT=./storage
MEDIA_SUBDIR=media

# Local LLM (Ollama). `OLLAMA_MODEL` is the default; users can override per-lecture at upload.
# Pull models with `ollama pull <name>` (e.g. `ollama pull qwen2.5:7b-instruct`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Per-call Ollama HTTP timeout in seconds. Raise this for large models on CPU:
# `qwen2.5:7b-instruct` on a modest CPU regularly needs 10–20 min per summary chunk,
# and the pipeline is single-job locked + retryable, so an over-generous ceiling is
# cheaper than a spurious timeout failure that forces a full retry.
LLM_TIMEOUT_SECONDS=1800
LLM_MAX_RETRIES=2

# Chunking (approximate token counts).
CHUNK_TOKENS=1800
CHUNK_OVERLAP_TOKENS=200

# ASR (faster-whisper).
# Model size — tests may override with `tiny` for speed.
WHISPER_MODEL_SIZE=medium
# Device: cpu | cuda | auto
WHISPER_DEVICE=auto
# Safe CPU default; when `auto` picks a GPU, float16 is used instead.
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD=true
WHISPER_FALLBACK_LANGUAGE=uk
WHISPER_LANGUAGE_DETECT_MIN_PROB=0.5
# CPU threads for CTranslate2. 0 = auto (all logical cores).
WHISPER_CPU_THREADS=0

# Web.
# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:5173
